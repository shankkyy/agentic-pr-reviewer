# Copy to .env (never commit .env). Values here are placeholders.

# --- LLM provider -----------------------------------------------------------
# mock       : deterministic offline provider, no API key needed (default)
# openai     : any OpenAI-compatible /chat/completions endpoint
# anthropic  : Anthropic Messages API
LLM_PROVIDER=mock
LLM_MODEL=mock-deterministic-v1
# Required for openai/anthropic. Never commit a real key.
LLM_API_KEY=
# Optional override, e.g. https://api.openai.com/v1 or https://api.anthropic.com
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_OUTPUT_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=1.0
LLM_MAX_OUTPUT_TOKENS=2048
# Optional: set both to report estimated cost. Leave empty to report "not measured".
LLM_INPUT_PRICE_PER_MTOK=
LLM_OUTPUT_PRICE_PER_MTOK=

# --- Limits -------------------------------------------------------------------
MAX_UPLOAD_BYTES=1048576
MAX_FILES=50
MAX_HUNKS=500
MAX_REVIEW_PROMPT_CHARS=40000
MAX_TEST_SUGGESTIONS=5
MAX_CONCURRENT_REVIEWS=2
REVIEW_TIMEOUT_SECONDS=300
STATIC_TOOL_TIMEOUT_SECONDS=30

# --- Static analysis ------------------------------------------------------------
# Comma-separated subset of: ruff,bandit. Missing tools are reported, not fatal.
ENABLE_STATIC_TOOLS=ruff,bandit

# --- Persistence and server ---------------------------------------------------
DATABASE_PATH=data/reviews.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# --- Frontend (read by Next.js at build/dev time) -------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
